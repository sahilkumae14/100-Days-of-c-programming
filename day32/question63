/*Q63: Merge two arrays.


Sample Test Cases:
Input 1:
3
1 2 3
2
4 5
Output 1:
1 2 3 4 5

*/
#include <stdio.h>

int main() {
    int n, m;

    // Size of first array
    scanf("%d", &n);

    int a[n];

    // Input first array
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    // Size of second array
    scanf("%d", &m);

    int b[m];

    // Input second array
    for (int i = 0; i < m; i++) {
        scanf("%d", &b[i]);
    }

    // Print first array
    for (int i = 0; i < n; i++) {
        printf("%d ", a[i]);
    }

    // Print second array after first array
    for (int i = 0; i < m; i++) {
        printf("%d ", b[i]);
    }

    return 0;
}