/*Q54: Write a program to print the following pattern:

   *
  ***
 *****
*******
 *****
  ***
   *



Sample Test Cases:
Input 1:

Output 1:
Pattern with layers of stars as shown.

*/
#include <stdio.h>

int main()
{
    int i, j, space;

    // Upper part
    for(i = 1; i <= 4; i++)
    {
        // Spaces
        for(space = 1; space <= 4 - i; space++)
        {
            printf(" ");
        }

        // Stars
        for(j = 1; j <= 2 * i - 1; j++)
        {
            printf("*");
        }

        printf("\n");
    }

    // Lower part
    for(i = 3; i >= 1; i--)
    {
        // Spaces
        for(space = 1; space <= 4 - i; space++)
        {
            printf(" ");
        }

        // Stars
        for(j = 1; j <= 2 * i - 1; j++)
        {
            printf("*");
        }

        printf("\n");
    }

    return 0;
}