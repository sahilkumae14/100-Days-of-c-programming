/*Q58: Find the maximum and minimum element in an array.


Sample Test Cases:
Input 1:
5
2 9 1 4 7
Output 1:
Max=9, Min=1

Input 2:
3
10 10 10
Output 2:
Max=10, Min=10

*/
#include <stdio.h>

int main()
{
    int n, i;
    int arr[100];
    int max, min;

    scanf("%d", &n);

    // Array elements input lena
    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    // Pehle element ko max aur min maan lo
    max = arr[0];
    min = arr[0];

    // Maximum aur minimum find karna
    for(i = 1; i < n; i++)
    {
        if(arr[i] > max)
        {
            max = arr[i];
        }

        if(arr[i] < min)
        {
            min = arr[i];
        }
    }

    printf("Max=%d, Min=%d", max, min);

    return 0;
}