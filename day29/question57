/*Q57: Find the sum of array elements.


Sample Test Cases:
Input 1:
4
2 4 6 8
Output 1:
20

Input 2:
3
1 1 1
Output 2:
3

*/
#include <stdio.h>

int main()
{
    int n, i;
    int arr[100];
    int sum = 0;

    scanf("%d", &n);

    // Array elements input lena
    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    // Sum calculate karna
    for(i = 0; i < n; i++)
    {
        sum = sum + arr[i];
    }

    printf("%d", sum);

    return 0;
}