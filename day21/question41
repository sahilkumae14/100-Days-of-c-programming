/*Q41: Write a program to swap the first and last digit of a number.


Sample Test Cases:
Input 1:
1234
Output 1:
4231

Input 2:
1001
Output 2:
1001

*/
#include <stdio.h>

int main()
{
    int n, first, last, digits, power, middle, result;

    scanf("%d", &n);

    // Last digit
    last = n % 10;

    // First digit aur total digits find karna
    digits = n;
    power = 1;

    while (digits >= 10)
    {
        digits = digits / 10;
        power = power * 10;
    }

    first = digits;

    // Middle part
    middle = (n % power) / 10;

    // First aur last digit swap
    result = last * power + middle * 10 + first;

    printf("%d", result);

    return 0;
}
